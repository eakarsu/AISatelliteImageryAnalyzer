NODE_ENV=development
JWT_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satellite_analyzer
DB_USER=postgres
DB_PASSWORD=replace-with-local-password
DATABASE_SSL=false
# Required as a PEM value when DATABASE_SSL=true and the system trust store is insufficient.
DATABASE_CA_CERT=
ENABLE_LEGACY_PROVIDER_ROUTES=false
ENABLE_LEGACY_SCHEMA_BOOTSTRAP=false
OPENROUTER_API_KEY=
